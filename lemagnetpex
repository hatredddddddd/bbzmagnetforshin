-- Ball Magnet + Hitbox Expander (Matcha)
-- Both are client-side. They only "work" if the game decides hits / ball contact on YOUR client
-- (or you own the ball's network ownership).

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ===== helpers =====
local function getBall()
    local ball = workspace:FindFirstChild("Basketball")
    if not ball then return nil end
    if ball:IsA("BasePart") then return ball end
    return ball.PrimaryPart or ball:FindFirstChildWhichIsA("BasePart")
end

local function getRoot(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local original = {}

local function setHitbox(player, size)
    local root = getRoot(player.Character)
    if not root then return end
    if original[root] == nil then original[root] = root.Size end
    pcall(function()
        root.Size = size
        root.Transparency = 0.85
        root.CanCollide = false
    end)
end

local function restoreHitboxes()
    for root, size in pairs(original) do
        pcall(function() root.Size = size end)
    end
    original = {}
end

-- ===== menu =====
-- The tab callback runs EVERY frame, so anything one-time (hotkey overlay) is guarded,
-- and each widget is wrapped so one failing call can't hide the rest of the menu.
local magKb, hbKb
local hotkeysAdded = false
local reported = {}

local function safe(label, fn)
    local ok, err = pcall(fn)
    if not ok and not reported[label] then
        reported[label] = true
        print("[UI] '" .. label .. "' failed: " .. tostring(err))
    end
end

UI.AddTab("Hitbox & Magnet", function(tab)
    local mag = tab:Section("Ball Magnet", "Left")
    safe("mg_on", function() mag:Toggle("mg_on", "Magnet") end)
    safe("mg_kb", function() magKb = mag:Keybind("mg_kb", 0x47, "toggle") end) -- G
    safe("mg_range", function() mag:SliderInt("mg_range", "Range (studs)", 5, 60, 20) end)
    safe("mg_strength", function() mag:SliderInt("mg_strength", "Pull Strength", 5, 120, 40) end)
    safe("mg_mode", function() mag:Combo("mg_mode", "Mode", {"Velocity pull", "Snap to hand"}, 0) end)

    local hb = tab:Section("Hitbox Expander", "Right")
    safe("hb_on", function() hb:Toggle("hb_on", "Expand Enemy Hitboxes") end)
    safe("hb_kb", function() hbKb = hb:Keybind("hb_kb", 0x48, "toggle") end) -- H
    safe("hb_size", function() hb:SliderInt("hb_size", "Size", 2, 30, 8) end)
    safe("hb_team", function() hb:Toggle("hb_team", "Team Check", true) end)

    if not hotkeysAdded and magKb and hbKb then
        hotkeysAdded = true
        safe("hotkeys", function()
            magKb:AddToHotkey("Magnet", "mg_on")
            hbKb:AddToHotkey("Hitbox", "hb_on")
        end)
    end
end)

-- ===== ball magnet loop =====
task.spawn(function()
    while true do
        wait(0.02)
        if UI.GetValue("mg_on") and (magKb == nil or magKb:IsEnabled()) then
            local ball = getBall()
            local root = getRoot(LocalPlayer.Character)
            if ball and root then
                local toMe = root.Position - ball.Position
                local dist = toMe.Magnitude
                if dist <= (UI.GetValue("mg_range") or 20) and dist > 1.5 then
                    if (UI.GetValue("mg_mode") or 0) == 0 then
                        pcall(function()
                            ball.AssemblyLinearVelocity = toMe.Unit * (UI.GetValue("mg_strength") or 40)
                        end)
                    else
                        pcall(function()
                            ball.Position = root.Position + root.CFrame.LookVector * 2 + Vector3.new(0, 1, 0)
                        end)
                    end
                end
            end
        end
    end
end)

-- ===== hitbox loop =====
local wasOn = false
task.spawn(function()
    while true do
        wait(0.25)
        local on = UI.GetValue("hb_on") and (hbKb == nil or hbKb:IsEnabled())
        if on then
            local s = UI.GetValue("hb_size") or 8
            local size = Vector3.new(s, s, s)
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local sameTeam = UI.GetValue("hb_team") and p.Team ~= nil and p.Team == LocalPlayer.Team
                    if not sameTeam then setHitbox(p, size) end
                end
            end
            wasOn = true
        elseif wasOn then
            restoreHitboxes()
            wasOn = false
        end
    end
end)

notify("Magnet (G) + Hitbox (H) loaded.", "Matcha", 4)
